# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LLM (OpenRouter-compatible)
OPENAI_API_KEY=YOUR_OPENROUTER_OR_OPENAI_KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-120b:free
OPENROUTER_APP_URL=https://linkdprints.com
OPENROUTER_APP_NAME=LD Brain Nandu Form

# App
NEXT_PUBLIC_APP_NAME=Nandu Web App Form

# Optional: Google Sheets sync via Apps Script web app.
# Paste the deployed web-app URL from docs/apps-script-template.gs.
# Leave blank to disable Sheets sync.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: admin passcode for the future /admin UI (v1.2.1).
# Any string; rotated by changing this value and redeploying.
ADMIN_PASSCODE=

# Optional: lock the landing page to a single role. When set to a coded
# role key (e.g. "nandu" or "gaurav"), the chooser only shows that one
# button and the hero title auto-uses that role's label. Used to deploy
# the same codebase as separate per-respondent URLs.
# Leave blank to show all visible roles.
NEXT_PUBLIC_INTERVIEW_ROLE=
